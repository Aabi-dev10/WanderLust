<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-5">
                        <i
                            class="fa-solid fa-sitemap"
                            style="font-size: 3rem; color: #ff385c;"
                        ></i>

                        <h1 class="fw-bold mt-3">
                            WanderLust Sitemap
                        </h1>

                        <p class="text-muted mb-0">
                            Explore the main sections of WanderLust.
                        </p>
                    </div>

                    <div class="list-group list-group-flush">

                        <a
                            href="/"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-house me-2"></i>
                            Home
                        </a>

                        <a
                            href="/listings"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-compass me-2"></i>
                            All Listings
                        </a>

                        <a
                            href="/listings?category=Trending"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-fire me-2"></i>
                            Trending
                        </a>

                        <a
                            href="/listings?category=Rooms"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-bed me-2"></i>
                            Rooms
                        </a>

                        <a
                            href="/listings?category=Mountains"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-mountain me-2"></i>
                            Mountains
                        </a>

                        <a
                            href="/signup"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-user-plus me-2"></i>
                            Sign Up
                        </a>

                        <a
                            href="/login"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-right-to-bracket me-2"></i>
                            Log In
                        </a>

                        <a
                            href="/privacy"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-shield-halved me-2"></i>
                            Privacy Policy
                        </a>

                        <a
                            href="/terms"
                            class="list-group-item list-group-item-action py-3"
                        >
                            <i class="fa-solid fa-file-contract me-2"></i>
                            Terms of Service
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>