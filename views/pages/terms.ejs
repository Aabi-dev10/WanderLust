<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-5">
                        <i
                            class="fa-solid fa-file-contract"
                            style="font-size: 3rem; color: #ff385c;"
                        ></i>

                        <h1 class="fw-bold mt-3">
                            Terms of Service
                        </h1>

                        <p class="text-muted mb-0">
                            Please read these terms before using WanderLust.
                        </p>
                    </div>

                    <h4 class="fw-bold">
                        Using WanderLust
                    </h4>

                    <p class="text-muted">
                        By using WanderLust, you agree to use the platform
                        responsibly and in accordance with applicable laws.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Accounts
                    </h4>

                    <p class="text-muted">
                        You are responsible for maintaining the security
                        of your account and login credentials.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Listings
                    </h4>

                    <p class="text-muted">
                        Property information should be accurate and
                        presented honestly. Users should not create
                        misleading listings or provide fraudulent
                        information.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Bookings
                    </h4>

                    <p class="text-muted">
                        Users are responsible for reviewing booking
                        information before confirming a reservation.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Reviews
                    </h4>

                    <p class="text-muted">
                        Reviews should be based on genuine experiences
                        and should not contain abusive, fraudulent, or
                        misleading content.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Prohibited Activities
                    </h4>

                    <p class="text-muted">
                        Users must not misuse the platform, attempt to
                        gain unauthorized access, submit malicious
                        content, or interfere with the operation of
                        WanderLust.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Platform Changes
                    </h4>

                    <p class="text-muted">
                        WanderLust may update, modify, or improve
                        platform features from time to time.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Contact
                    </h4>

                    <p class="text-muted">
                        If you have questions regarding these terms,
                        please contact the WanderLust team.
                    </p>

                    <hr class="my-4">

                    <p class="text-muted small mb-0">
                        Last updated:
                        <%= new Date().getFullYear() %>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>