<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h1 class="fw-bold mb-4">
                        Privacy Policy
                    </h1>

                    <p class="text-muted">
                        Welcome to WanderLust. Your privacy is important
                        to us. This page explains how information is
                        handled when you use our platform.
                    </p>

                    <hr class="my-4">

                    <h4 class="fw-bold mt-4">
                        Information We Collect
                    </h4>

                    <p>
                        WanderLust may collect information such as your
                        username, email address, profile information,
                        listings, bookings, and reviews that you provide
                        while using the platform.
                    </p>

                    <h4 class="fw-bold mt-4">
                        How We Use Your Information
                    </h4>

                    <p>
                        We use the information you provide to create and
                        manage your account, process bookings, provide
                        platform features, and improve your experience.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Account Security
                    </h4>

                    <p>
                        Please keep your login credentials secure.
                        WanderLust will not ask you to share your password
                        through an unsolicited message.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Cookies and Sessions
                    </h4>

                    <p>
                        WanderLust may use sessions and cookies to keep
                        you signed in and provide essential functionality.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Third-Party Services
                    </h4>

                    <p>
                        Some features of WanderLust may use third-party
                        services such as cloud storage, maps, or email
                        delivery. Those services may process information
                        according to their own privacy policies.
                    </p>

                    <h4 class="fw-bold mt-4">
                        Contact
                    </h4>

                    <p>
                        If you have questions about this Privacy Policy,
                        please contact the WanderLust team.
                    </p>

                    <p class="text-muted small mt-5 mb-0">
                        Last updated: <%= new Date().getFullYear() %>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>