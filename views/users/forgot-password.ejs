<% layout("/layouts/boilerplate") %>
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div
                class="card border-0 shadow-sm"
                style="border-radius:20px;"
            >
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div
                            style="
                                width:65px;
                                height:65px;
                                margin:0 auto 18px;
                                border-radius:50%;
                                background:#fff0f2;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:28px;
                            "
                        >
                            🔐
                        </div>
                        <h2 class="fw-bold mb-2">
                            Forgot Password?
                        </h2>
                        <p class="text-muted mb-0">
                            Enter your email and we'll send you
                            a password reset link.
                        </p>
                    </div>
                    <form
                        action="/forgot-password"
                        method="POST"
                    >
                        <div class="mb-4">
                            <label
                                for="email"
                                class="form-label fw-semibold"
                            >
                                Email address
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="form-control"
                                placeholder="Enter your email"
                                required
                                autocomplete="email"
                                style="
                                    border-radius:10px;
                                    padding:12px;
                                "
                            >
                        </div>
                        <button
                            type="submit"
                            class="btn w-100 text-white fw-semibold"
                            style="
                                background:#ff385c;
                                border-radius:10px;
                                padding:12px;
                            "
                        >
                            Send Reset Link
                        </button>
                    </form>
                    <div class="text-center mt-4">

                        <a
                            href="/login"
                            class="text-decoration-none"
                            style="color:#ff385c;"
                        >
                            ← Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>