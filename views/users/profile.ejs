<% layout("/layouts/boilerplate") %>

<style>

    :root {
        --airbnb-red: #ff385c;
        --airbnb-black: #222;
        --airbnb-gray: #717171;
        --airbnb-border: #ddd;
    }


    body {
        background: #fff;
        color: var(--airbnb-black);
    }


    .profile-page {
        max-width: 1120px;
        margin: auto;
        padding: 32px 24px 70px;
    }


    /* Profile Header */

    .profile-header {
        border: 1px solid var(--airbnb-border);
        border-radius: 18px;
        padding: 28px 30px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }


    .profile-avatar,
    .profile-avatar-img {
        width: 88px;
        height: 88px;
        min-width: 88px;
        border-radius: 50%;
    }


    .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #222;
        color: #fff;
        font-size: 34px;
        font-weight: 600;
    }


    .profile-avatar-img {
        object-fit: cover;
    }


    .profile-name {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
    }


    .profile-email {
        margin: 6px 0 0;
        color: var(--airbnb-gray);
        font-size: 14px;
    }


    /* Buttons */

    .airbnb-dark-btn,
    .airbnb-red-btn,
    .airbnb-outline-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }


    .airbnb-dark-btn {
        min-height: 42px;
        padding: 0 20px;
        border: 1px solid #222;
        border-radius: 10px;
        background: #222;
        color: #fff !important;
        font-size: 14px;
    }


    .airbnb-dark-btn:hover {
        background: #000;
    }


    .airbnb-red-btn {
        min-height: 42px;
        padding: 0 20px;
        border-radius: 10px;
        background: var(--airbnb-red);
        color: #fff !important;
        font-size: 14px;
    }


    .airbnb-red-btn:hover {
        background: #e31c5f;
    }


    .airbnb-outline-btn {
        min-height: 40px;
        padding: 0 18px;
        border: 1px solid #222;
        border-radius: 9px;
        background: #fff;
        color: #222 !important;
        font-size: 13px;
    }


    .airbnb-outline-btn:hover {
        background: #f7f7f7;
    }


    /* Sections */

    .profile-section {
        margin-top: 46px;
    }


    .section-heading-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }


    .section-title {
        margin: 0;
        font-size: 22px;
        font-weight: 600;
    }


    /* Listings */

    .my-listings-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }


    .profile-card {
        height: 100%;
        overflow: hidden;
    }


    .listing-image-wrapper {
        width: 100%;
        aspect-ratio: 1 / 0.78;
        overflow: hidden;
        border-radius: 14px;
        background: #f2f2f2;
    }


    .listing-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 14px;
    }


    .listing-card-body {
        padding: 12px 2px 0;
    }


    .listing-card-title {
        margin: 0 0 5px;
        font-size: 16px;
        font-weight: 600;
    }


    .listing-location {
        margin: 0 0 6px;
        color: var(--airbnb-gray);
        font-size: 13px;
    }


    .listing-price {
        margin: 0 0 13px;
        font-size: 14px;
    }


    /* Bookings */

    .booking-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }


    .booking-card {
        padding: 16px;
        border: 1px solid var(--airbnb-border);
        border-radius: 14px;
        background: #fff;
    }


    .booking-image {
        width: 100%;
        height: 125px;
        object-fit: cover;
        border-radius: 10px;
    }


    .booking-title {
        margin: 0 0 7px;
        font-size: 17px;
        font-weight: 600;
    }


    .booking-location {
        margin: 0 0 12px;
        color: var(--airbnb-gray);
        font-size: 13px;
    }


    .booking-dates {
        margin: 0 0 4px;
        font-size: 13px;
    }


    .booking-total-label {
        margin: 0 0 3px;
        color: var(--airbnb-gray);
        font-size: 12px;
    }


    .booking-total {
        margin: 0 0 12px;
        font-size: 18px;
        font-weight: 600;
    }


    /* Empty State */

    .empty-state {
        padding: 55px 25px;
        text-align: center;
        border: 1px solid var(--airbnb-border);
        border-radius: 16px;
    }


    .empty-state-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f7f7f7;
        font-size: 23px;
    }


    .empty-state h5 {
        margin: 0 0 7px;
        font-size: 18px;
        font-weight: 600;
    }


    .empty-state p {
        margin: 0 0 20px;
        color: var(--airbnb-gray);
        font-size: 14px;
    }


    /* Responsive */

    @media (max-width: 991px) {

        .my-listings-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }


    @media (max-width: 767px) {

        .profile-page {
            padding: 22px 16px 50px;
        }


        .profile-header {
            padding: 22px;
        }


        .profile-avatar,
        .profile-avatar-img {
            width: 72px;
            height: 72px;
            min-width: 72px;
        }


        .profile-name {
            font-size: 22px;
        }


        .section-heading-row {
            align-items: flex-start;
            flex-direction: column;
        }


        .section-heading-row .airbnb-red-btn {
            width: 100%;
        }


        .my-listings-grid {
            grid-template-columns: 1fr;
        }


        .booking-image {
            height: 190px;
            margin-bottom: 15px;
        }

    }


    @media (max-width: 480px) {

        .profile-header {
            padding: 20px;
        }


        .airbnb-dark-btn {
            width: 100%;
        }


        .profile-email {
            font-size: 13px;
        }

    }

</style>

<div class="profile-page">
    <div class="profile-header mb-0">

        <div
            class="d-flex justify-content-between align-items-center flex-wrap gap-3"
        >

            <div class="d-flex align-items-center gap-4">


                <% if (user.profileImage && user.profileImage.url) { %>


                    <img
                        src="<%= user.profileImage.url %>"
                        alt="Profile Picture"
                        class="profile-avatar-img"
                    >


                <% } else { %>


                    <div class="profile-avatar">

                        <%= user.username.charAt(0).toUpperCase() %>

                    </div>


                <% } %>


                <div>

                    <h2 class="profile-name">

                        <%= user.username %>

                    </h2>


                    <p class="profile-email">

                        <%= user.email %>

                    </p>

                </div>

            </div>
            <!-- EDIT PROFILE -->
            <a
                href="/profile/edit"
                class="airbnb-dark-btn"
            >

                <i class="fa-solid fa-pen-to-square me-2"></i>

                Edit Profile

            </a>


        </div>

    </div>
    <section class="profile-section">


        <div class="section-heading-row">


            <h3 class="section-title">

                My Listings

            </h3>


            <a
                href="/listings/new"
                class="airbnb-red-btn"
            >

                <i class="fa-solid fa-plus me-2"></i>

                Add Listing

            </a>


        </div>


        <% if (listings.length > 0) { %>


            <div class="my-listings-grid">


                <% listings.forEach(listing => { %>


                    <div class="profile-card">


                        <!-- LISTING IMAGE -->

                        <div class="listing-image-wrapper">

                            <img
                                src="<%= listing.image.url %>"
                                class="listing-image"
                                alt="<%= listing.title %>"
                                loading="lazy"
                            >

                        </div>


                        <!-- LISTING DETAILS -->

                        <div class="listing-card-body">


                            <h5 class="listing-card-title">

                                <%= listing.title %>

                            </h5>


                            <p class="listing-location">

                                <i class="fa-solid fa-location-dot me-1"></i>

                                <%= listing.location %>,
                                <%= listing.country %>

                            </p>


                            <p class="listing-price">

                                <strong>

                                    Rs.
                                    <%= listing.price.toLocaleString("en-PK") %>

                                </strong>

                                / night

                            </p>


                            <!-- EXISTING LINK PRESERVED -->

                            <a
                                href="/listings/<%= listing._id %>"
                                class="airbnb-outline-btn w-100"
                            >

                                View Listing

                            </a>


                        </div>


                    </div>


                <% }) %>


            </div>


        <% } else { %>


            <!-- EMPTY LISTINGS -->

            <div class="empty-state">


                <div class="empty-state-icon">

                    <i class="fa-solid fa-house"></i>

                </div>


                <h5>

                    You don't have any listings yet.

                </h5>


                <p>

                    Start hosting your property on Wanderlust.

                </p>


                <a
                    href="/listings/new"
                    class="airbnb-red-btn"
                >

                    Create Your First Listing

                </a>


            </div>


        <% } %>


    </section>

    <section class="profile-section">


        <div class="section-heading-row">

            <h3 class="section-title">

                My Bookings

            </h3>

        </div>


        <% if (bookings.length > 0) { %>


            <div class="booking-list">


                <% bookings.forEach(booking => { %>


                    <div class="booking-card">


                        <div class="row align-items-center">


                            <!-- BOOKING IMAGE -->

                            <div class="col-md-3 mb-3 mb-md-0">


                                <% if (booking.listing && booking.listing.image) { %>


                                    <img
                                        src="<%= booking.listing.image.url %>"
                                        class="booking-image"
                                        alt="<%= booking.listing.title %>"
                                    >


                                <% } %>


                            </div>



                            <!-- BOOKING DETAILS -->

                            <div class="col-md-6">


                                <% if (booking.listing) { %>


                                    <h5 class="booking-title">

                                        <%= booking.listing.title %>

                                    </h5>


                                    <p class="booking-location">

                                        <i
                                            class="fa-solid fa-location-dot me-1"
                                        ></i>

                                        <%= booking.listing.location %>,
                                        <%= booking.listing.country %>

                                    </p>


                                <% } else { %>


                                    <h5 class="booking-title">

                                        Listing no longer available

                                    </h5>


                                <% } %>


                                <p class="booking-dates">

                                    <strong>
                                        Check-in:
                                    </strong>

                                    <%= booking.checkIn.toLocaleDateString() %>

                                </p>


                                <p class="booking-dates">

                                    <strong>
                                        Check-out:
                                    </strong>

                                    <%= booking.checkOut.toLocaleDateString() %>

                                </p>


                            </div>



                            <!-- BOOKING PRICE -->

                            <div
                                class="col-md-3 text-md-end"
                            >


                                <p class="booking-total-label">

                                    Total Price

                                </p>


                                <h5 class="booking-total">

                                    Rs.
                                    <%= booking.totalPrice.toLocaleString("en-PK") %>

                                </h5>


                                <% if (booking.listing) { %>


                                    <a
                                        href="/listings/<%= booking.listing._id %>"
                                        class="airbnb-outline-btn"
                                    >

                                        View Listing

                                    </a>


                                <% } %>


                            </div>


                        </div>


                    </div>


                <% }) %>


            </div>


        <% } else { %>


            <!-- EMPTY BOOKINGS -->

            <div class="empty-state booking-empty">


                <div class="empty-state-icon">

                    <i class="fa-solid fa-calendar-xmark"></i>

                </div>


                <h5>

                    No bookings yet.

                </h5>


                <p>

                    Your reservations will appear here.

                </p>


                <a
                    href="/listings"
                    class="airbnb-red-btn"
                >

                    Explore Listings

                </a>


            </div>


        <% } %>


    </section>


</div>