<% layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div
                class="card border-0 shadow-sm"
                style="border-radius:20px;"
            >

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div
                            style="
                                width:65px;
                                height:65px;
                                margin:0 auto 18px;
                                border-radius:50%;
                                background:#fff0f2;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                font-size:28px;
                            "
                        >
                            🔐
                        </div>

                        <h2 class="fw-bold mb-2">
                            Reset Your Password
                        </h2>

                        <p class="text-muted mb-0">
                            Create a new password for your Wanderlust account.
                        </p>

                    </div>

                    <form
                        action="/reset-password/<%= token %>"
                        method="POST"
                    >

                        <div class="mb-3">

                            <label
                                for="password"
                                class="form-label fw-semibold"
                            >
                                New Password
                            </label>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="form-control"
                                placeholder="Enter your new password"
                                minlength="6"
                                required
                                autocomplete="new-password"
                                style="
                                    border-radius:10px;
                                    padding:12px;
                                "
                            >

                        </div>

                        <div class="mb-4">

                            <label
                                for="confirmPassword"
                                class="form-label fw-semibold"
                            >
                                Confirm New Password
                            </label>

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                class="form-control"
                                placeholder="Confirm your new password"
                                minlength="6"
                                required
                                autocomplete="new-password"
                                style="
                                    border-radius:10px;
                                    padding:12px;
                                "
                            >

                        </div>

                        <button
                            type="submit"
                            class="btn w-100 text-white fw-semibold"
                            style="
                                background:#ff385c;
                                border-radius:10px;
                                padding:12px;
                            "
                        >
                            Reset Password
                        </button>

                    </form>

                    <div class="text-center mt-4">

                        <a
                            href="/login"
                            class="text-decoration-none"
                            style="color:#ff385c;"
                        >
                            ← Back to Login
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>