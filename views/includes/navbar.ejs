    position: relative;
    z-index: 1050;
}

* {
    box-sizing: border-box;
}
.brand-logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none !important;
    white-space: nowrap;
    color: #222 !important;
    flex-shrink: 0;
}

.wanderlust-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
}

.brand-logo:hover .wanderlust-logo {
    transform: rotate(-4deg) scale(1.04);
}

.brand-logo-text {
    color: #222;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.7px;
    line-height: 1;
}
.navbar-main-content {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    margin-left: 2rem;
}
.desktop-search-area {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
}

.search-wrapper {
    width: min(100%, 430px);
    min-height: 3rem;

    display: flex;
    align-items: center;

    background: #ffffff;

    border: 1px solid #dddddd;
    border-radius: 2rem;

    padding: 0.2rem 0.3rem 0.2rem 0.9rem;

    box-shadow:
        0 1px 2px rgba(0, 0, 0, 0.05);

    transition: 0.2s ease;
}

.search-wrapper:hover {
    border-color: #bdbdbd;
}

.search-wrapper:focus-within {
    border-color: #aaa;
}

.search-inp {
    flex: 1;
    min-width: 0;

    border: none !important;
    outline: none !important;
    box-shadow: none !important;

    background: transparent !important;

    font-size: 0.88rem;

    padding: 0.5rem 0.65rem !important;
}

.search-inp::placeholder {
    color: #717171;
}

.search-btn {
    width: 2.35rem;
    height: 2.35rem;

    flex-shrink: 0;

    border: none !important;
    border-radius: 50% !important;

    background: #ff385c !important;
    color: white !important;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0 !important;

    transition: 0.2s ease;
}

.search-btn:hover {
    background: #e61e4d !important;
    transform: scale(1.03);
}

.desktop-right-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 1.7rem;
    flex-shrink: 0;
}

.nav-link-premium {
