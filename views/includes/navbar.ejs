}

.sidebar-account-info {

    min-width: 0;
}

.sidebar-account-label {

    color: #717171;

    font-size: 0.62rem;
}

.sidebar-account-name {

    color: #222;

    font-size: 0.8rem;

    font-weight: 700;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}
.sidebar-section {

    padding-top: 0.7rem;

    margin-top: 0.7rem;

    border-top: 1px solid #eeeeee;
}

.sidebar-link {

    width: 100%;

    min-height: 2.65rem;

    display: flex;

    align-items: center;

    gap: 0.65rem;

    padding: 0.48rem 0.55rem;

    margin-bottom: 0.2rem;

    border-radius: 0.7rem;

    color: #222 !important;

    text-decoration: none;

    font-size: 0.82rem;

    font-weight: 600;

    transition: 0.15s ease;
}

.sidebar-link:hover {

    background: #f7f7f7;

    transform: translateX(2px);
}

.sidebar-link-icon {

    width: 1.9rem;
    height: 1.9rem;

    flex-shrink: 0;

    border-radius: 0.55rem;

    background: #f7f7f7;

    display: flex;

    align-items: center;
    justify-content: center;

    color: #555;

    font-size: 0.75rem;
}

@media (max-width: 991.98px) {

    .custom-navbar {

        min-height: 4.65rem;

        padding-left: 1rem !important;

        padding-right: 1rem !important;
    }

    .navbar-main-content {

        display: none;
    }

    .mobile-menu-button {

        display: flex;
    }

}
@media (max-width: 575.98px) {

    .custom-navbar {

        min-height: 4.35rem;

        padding-left: 0.7rem !important;

        padding-right: 0.7rem !important;
    }

    .wanderlust-logo {

        width: 34px;
        height: 34px;
    }

    .brand-logo-text {

        font-size: 1.18rem;
    }

    .mobile-menu-button {

        width: 2.4rem;
        height: 2.4rem;

        font-size: 0.82rem;
    }

    /*
       Compact mobile sidebar
    */

    .mobile-sidebar {

        width: 280px;

        max-width: 82vw;
    }

    .sidebar-top {

        height: 58px;

        padding: 0 0.75rem;
    }

    .sidebar-content {

        padding: 0.7rem;
    }

    .airbnb-clone-line {

        height: 19px;
    }

    .airbnb-clone-text {

        font-size: 0.5rem;

        padding-right: 55px;
    }

}
@media (max-width: 380px) {

    .mobile-sidebar {

        width: 260px;

        max-width: 80vw;
    }

    .sidebar-brand-text {

        font-size: 1.05rem;
    }

    .sidebar-link {

        min-height: 2.5rem;

        font-size: 0.78rem;

        padding: 0.4rem 0.5rem;
    }

    .sidebar-link-icon {

        width: 1.8rem;
        height: 1.8rem;
    }

    .sidebar-account {

        padding: 0.55rem;
    }

    .sidebar-search .search-wrapper {

        min-height: 2.5rem;
    }

}
@media (max-width: 767px) and (orientation: landscape) {

    .mobile-sidebar {

        width: 270px;

        max-width: 75vw;
    }

    .sidebar-top {

        height: 54px;
    }

    .sidebar-content {

        padding: 0.6rem;
    }

}

