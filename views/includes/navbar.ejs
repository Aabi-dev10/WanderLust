    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    font-weight: 700;
}

.account-header-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.account-header-text {
    min-width: 0;
}

.account-welcome {
    color: #717171;
    font-size: 0.68rem;
}

.account-username {
    color: #222;
    font-size: 0.88rem;
    font-weight: 700;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.premium-dropdown .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    color: #222;

    font-size: 0.84rem;

    padding: 0.62rem 0.65rem;

    border-radius: 0.7rem;

    transition: 0.15s ease;
}

.premium-dropdown .dropdown-item:hover {
    background: #f7f7f7;
    color: #222;
}

.menu-icon {
    width: 1.9rem;
    height: 1.9rem;

    flex-shrink: 0;

    border-radius: 0.6rem;

    background: #f7f7f7;

    color: #555;

    display: flex;
    align-items: center;
    justify-content: center;
}

.menu-divider {
    height: 1px;
    background: #eeeeee;

    margin: 0.35rem 0.3rem;
}

.logout-item {
    color: #d92d20 !important;
}

.logout-item .menu-icon {
    background: #fff1f0;
    color: #d92d20;
}

.mobile-menu-button {
    display: none;

    width: 2.65rem;
    height: 2.65rem;

    border: 1px solid #dddddd;

    border-radius: 50%;

    background: #ffffff;

    color: #222;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    flex-shrink: 0;

    transition: 0.2s ease;
}

.mobile-menu-button:hover {
    background: #f7f7f7;
}
.airbnb-clone-line {
    position: absolute;

    left: 0;
    right: 0;

    bottom: -1px;

    height: 21px;

    background: #ffffff;

    overflow: hidden;

    display: flex;
    align-items: center;

    pointer-events: none;

    z-index: 20;

    border-top: 1px solid #eeeeee;
    border-bottom: 1px solid #eeeeee;
}

.airbnb-clone-track {
    display: flex;
    align-items: center;

    width: max-content;

    white-space: nowrap;

    will-change: transform;

    animation: airbnbCloneMove 18s linear infinite;
}

.airbnb-clone-text {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    color: #777777;

    background: #ffffff;

    font-size: 0.58rem;

    font-weight: 600;

    letter-spacing: 0.08em;

    text-transform: uppercase;

    padding-right: 80px;
}

.airbnb-clone-text i {
    color: #ff385c;
    font-size: 0.5rem;
    margin: 0 9px;
}

@keyframes airbnbCloneMove {

    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-50%);
    }

}
.sidebar-overlay {
    position: fixed;

    inset: 0;

    background: rgba(0, 0, 0, 0.38);

    z-index: 2000;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
}

.sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}
.mobile-sidebar {

    position: fixed;

    top: 0;
    right: 0;
    width: 280px;

    max-width: 82vw;

    height: 100vh;

    background: #ffffff;

    z-index: 2100;

    box-shadow:
        -8px 0 25px rgba(0, 0, 0, 0.13);

    transform: translateX(105%);

    visibility: hidden;

    transition:
        transform 0.3s cubic-bezier(.4, 0, .2, 1),
        visibility 0.3s ease;

    overflow-y: auto;
    overflow-x: hidden;

    -webkit-overflow-scrolling: touch;
}

.mobile-sidebar.active {
    transform: translateX(0);
    visibility: visible;
}

.sidebar-top {

    height: 62px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 0.9rem;

    border-bottom: 1px solid #eeeeee;
}

.sidebar-brand {

