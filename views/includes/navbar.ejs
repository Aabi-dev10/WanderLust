                    d="M19 49 C26 53 38 53 45 49"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.5"
                    stroke-linecap="round"
                />

            </svg>

            <span class="sidebar-brand-text">
                wanderlust
            </span>

        </a>


        <button
            type="button"
            class="sidebar-close"
            id="closeSidebar"
            aria-label="Close navigation menu"
        >

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <!-- SIDEBAR CONTENT -->

    <div class="sidebar-content">


        <!-- SEARCH -->

        <div class="sidebar-search">

            <form
                class="search-wrapper"
                action="/listings"
                method="GET"
                role="search"
            >

                <i
                    class="fa-solid fa-location-dot text-secondary"
                    style="font-size:0.72rem;"
                ></i>

                <input
                    class="form-control search-inp"
                    name="search"
                    type="search"
                    placeholder="Search..."
                    aria-label="Search destinations"
                    required
                >

                <button
                    class="btn search-btn"
                    type="submit"
                    aria-label="Search"
                >

                    <i
                        class="fa-solid fa-magnifying-glass"
                    ></i>

                </button>

            </form>

        </div>


        <!-- ACCOUNT -->

        <% if(currUser){ %>

            <div class="sidebar-account">

                <% if(
                    currUser.profileImage &&
                    currUser.profileImage.url
                ) { %>

                    <div class="sidebar-account-avatar">

                        <img
                            src="<%= currUser.profileImage.url %>"
                            alt="<%= currUser.username %>"
                        >

                    </div>

                <% } else { %>

                    <div class="sidebar-account-avatar">

                        <%= currUser.username
                            .charAt(0)
                            .toUpperCase() %>

                    </div>

                <% } %>


                <div class="sidebar-account-info">

                    <div class="sidebar-account-label">
                        Welcome back
                    </div>

                    <div class="sidebar-account-name">
                        <%= currUser.username %>
                    </div>

                </div>

            </div>

        <% } %>


        <!-- LINKS -->

        <div class="sidebar-section">


            <!-- WANDERLUST YOUR HOME -->

            <a
                href="/listings/new"
                class="sidebar-link close-sidebar-link"
            >

                <span class="sidebar-link-icon">

                    <i class="fa-solid fa-house"></i>

                </span>

                <span>
                    Wanderlust your home
                </span>

            </a>


            <% if(currUser){ %>


                <!-- PROFILE -->

                <a
                    href="/profile"
                    class="sidebar-link close-sidebar-link"
                >

                    <span class="sidebar-link-icon">

                        <i class="fa-solid fa-user"></i>

                    </span>

                    <span>
                        My Profile
                    </span>

                </a>


                <!-- LOGOUT -->

                <a
                    href="/logout"
                    class="sidebar-link close-sidebar-link"
                    style="color:#d92d20 !important;"
                >

                    <span
                        class="sidebar-link-icon"
                        style="color:#d92d20;background:#fff1f0;"
                    >

                        <i
                            class="fa-solid fa-arrow-right-from-bracket"
                        ></i>

                    </span>

                    <span>
                        Log out
                    </span>

                </a>


            <% } else { %>


                <!-- SIGN UP -->

                <a
                    href="/signup"
                    class="sidebar-link close-sidebar-link"
                >

                    <span class="sidebar-link-icon">

                        <i
                            class="fa-solid fa-user-plus"
                        ></i>

                    </span>

                    <span>
                        Sign up
                    </span>

                </a>


                <!-- LOGIN -->

                <a
                    href="/login"
                    class="sidebar-link close-sidebar-link"
                >

                    <span class="sidebar-link-icon">

                        <i
                            class="fa-solid fa-right-to-bracket"
                        ></i>

                    </span>

                    <span>
                        Log in
                    </span>

                </a>


            <% } %>

        </div>

    </div>

</aside>

<script>

document.addEventListener("DOMContentLoaded", function () {

    const openButton =
        document.getElementById("openSidebar");

    const closeButton =
        document.getElementById("closeSidebar");

    const sidebar =
        document.getElementById("mobileSidebar");

    const overlay =
        document.getElementById("sidebarOverlay");

    const links =
        document.querySelectorAll(".close-sidebar-link");


    /* OPEN */

    function openSidebar() {

        if (!sidebar || !overlay) return;

        sidebar.classList.add("active");

        overlay.classList.add("active");

        sidebar.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.style.overflow = "hidden";
    }


    /* CLOSE */

    function closeSidebar() {

        if (!sidebar || !overlay) return;

        sidebar.classList.remove("active");

        overlay.classList.remove("active");

        sidebar.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.style.overflow = "";
    }


    /* OPEN BUTTON */

    if (openButton) {

        openButton.addEventListener(
            "click",
            openSidebar
        );

    }


    /* CLOSE BUTTON */

    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeSidebar
        );

    }


    /* OVERLAY */

    if (overlay) {

        overlay.addEventListener(
            "click",
            closeSidebar
        );

    }


    /* LINKS */

    links.forEach(function (link) {

        link.addEventListener(
            "click",
            closeSidebar
        );

    });


    /* ESCAPE */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape" &&
                sidebar &&
                sidebar.classList.contains("active")
            ) {

                closeSidebar();

            }

        }
    );


    /* RESIZE */

    window.addEventListener(
        "resize",
        function () {

            if (window.innerWidth > 991) {

                closeSidebar();

            }

        }
    );

});

</script>

