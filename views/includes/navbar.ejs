        0 3px 10px rgba(0, 0, 0, 0.05) !important;
}

.account-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;

    padding: 0.65rem;

    border-bottom: 1px solid #eeeeee;

    margin-bottom: 0.3rem;
}

.account-header-avatar {
    width: 2.45rem;
    height: 2.45rem;

    flex-shrink: 0;

    border-radius: 50%;

    background: linear-gradient(
        135deg,
        #ff385c,
        #d70466
