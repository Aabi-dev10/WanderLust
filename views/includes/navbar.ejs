<div
    class="sidebar-overlay"
    id="sidebarOverlay"
></div>
<nav class="navbar custom-navbar sticky-top">

    <div class="container-fluid px-lg-3">


        <!-- BRAND -->

        <a
            href="/listings"
            class="brand-logo"
            aria-label="Wanderlust Home"
        >

            <svg
                class="wanderlust-logo"
                viewBox="0 0 64 64"
                xmlns="http://www.w3.org/2000/svg"
            >

                <rect
                    x="4"
                    y="4"
                    width="56"
                    height="56"
                    rx="18"
                    fill="#ff385c"
                />

                <path
                    d="M16 19 L23 43 L32 28 L41 43 L48 19"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />

                <circle
                    cx="32"
                    cy="28"
                    r="3.5"
                    fill="#ffffff"
                />

                <path
                    d="M19 49 C26 53 38 53 45 49"
                    fill="none"
                    stroke="#ffffff"
                    stroke-width="2.5"
                    stroke-linecap="round"
                />

            </svg>

            <span class="brand-logo-text">
                wanderlust
            </span>

        </a>


        <!-- DESKTOP CONTENT -->

        <div class="navbar-main-content">


            <!-- SEARCH -->

            <div class="desktop-search-area">

                <form
                    class="search-wrapper"
                    action="/listings"
                    method="GET"
                    role="search"
                >

                    <i
                        class="fa-solid fa-location-dot text-secondary"
                        style="font-size:0.82rem;"
                    ></i>

                    <input
                        class="form-control search-inp"
                        name="search"
                        type="search"
                        placeholder="Search destinations..."
                        aria-label="Search destinations"
                        required
                    >

                    <button
                        class="btn search-btn"
                        type="submit"
                        aria-label="Search"
                    >

                        <i class="fa-solid fa-magnifying-glass"></i>

                    </button>

                </form>

            </div>


            <!-- RIGHT NAV -->

            <div class="desktop-right-nav">


                <!-- HOST -->

                <a
                    href="/listings/new"
                    class="nav-link-premium"
                >

                    <i
                        class="fa-solid fa-house host-icon"
                    ></i>

                    Wanderlust your home

                </a>


                <!-- PROFILE -->

                <div class="dropdown">

                    <a
                        href="#"
                        class="profile-menu-btn"
                        role="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >

                        <i class="fa-solid fa-bars profile-bars"></i>


                        <% if(currUser) { %>

                            <% if(
                                currUser.profileImage &&
                                currUser.profileImage.url
                            ) { %>

                                <div class="user-avatar">

                                    <img
                                        src="<%= currUser.profileImage.url %>"
                                        alt="<%= currUser.username %>"
                                    >

                                </div>

                            <% } else { %>

                                <div class="user-avatar">

                                    <%= currUser.username
                                        .charAt(0)
                                        .toUpperCase() %>

                                </div>

                            <% } %>

                        <% } else { %>

                            <div class="guest-avatar">

                                <i class="fa-solid fa-user"></i>

                            </div>

                        <% } %>

                    </a>


                    <!-- DROPDOWN -->

                    <ul
                        class="dropdown-menu dropdown-menu-end premium-dropdown mt-2"
                    >

                        <% if(!currUser){ %>

                            <li>

                                <a
                                    href="/signup"
                                    class="dropdown-item fw-bold"
                                >

                                    <span class="menu-icon">

                                        <i
                                            class="fa-solid fa-user-plus"
                                        ></i>

                                    </span>

                                    Sign up

                                </a>

                            </li>


                            <li>

                                <a
                                    href="/login"
                                    class="dropdown-item"
                                >

                                    <span class="menu-icon">

                                        <i
                                            class="fa-solid fa-right-to-bracket"
                                        ></i>

                                    </span>

                                    Log in

                                </a>

                            </li>


                            <div class="menu-divider"></div>


                            <li>

                                <a
                                    href="/listings/new"
                                    class="dropdown-item"
                                >

                                    <span class="menu-icon">

                                        <i
                                            class="fa-solid fa-house"
                                        ></i>

                                    </span>

                                    Wanderlust your home

                                </a>

                            </li>

                        <% } %>


                        <% if(currUser){ %>

                            <li>

                                <div class="account-header">

                                    <% if(
                                        currUser.profileImage &&
                                        currUser.profileImage.url
                                    ) { %>

                                        <div
                                            class="account-header-avatar"
                                        >

                                            <img
                                                src="<%= currUser.profileImage.url %>"
                                                alt="<%= currUser.username %>"
                                            >

                                        </div>

                                    <% } else { %>

                                        <div
                                            class="account-header-avatar"
                                        >

                                            <%= currUser.username
                                                .charAt(0)
                                                .toUpperCase() %>

                                        </div>

                                    <% } %>


                                    <div
                                        class="account-header-text"
                                    >

                                        <div
                                            class="account-welcome"
                                        >
                                            Welcome back
                                        </div>

                                        <div
                                            class="account-username"
                                        >
                                            <%= currUser.username %>
                                        </div>

                                    </div>

                                </div>

                            </li>


                            <li>

                                <a
                                    href="/profile"
                                    class="dropdown-item"
                                >

                                    <span class="menu-icon">

                                        <i
                                            class="fa-solid fa-user"
                                        ></i>

                                    </span>

                                    My Profile

                                </a>

                            </li>


                            <div class="menu-divider"></div>


                            <li>

                                <a
                                    href="/logout"
                                    class="dropdown-item logout-item"
                                >

                                    <span class="menu-icon">

                                        <i
                                            class="fa-solid fa-arrow-right-from-bracket"
                                        ></i>

                                    </span>

                                    Log out

                                </a>

                            </li>

                        <% } %>

                    </ul>

                </div>

            </div>

        </div>


        <!-- MOBILE MENU BUTTON -->

        <button
            type="button"
            class="mobile-menu-button"
            id="openSidebar"
            aria-label="Open navigation menu"
        >

            <i class="fa-solid fa-bars"></i>

        </button>

    </div>


    <!-- MOVING LINE -->

    <div class="airbnb-clone-line">

        <div class="airbnb-clone-track">

            <span class="airbnb-clone-text">

                <i class="fa-solid fa-star"></i>

                This is an Airbnb Clone Project

                <i class="fa-solid fa-star"></i>

            </span>

            <span class="airbnb-clone-text">

                <i class="fa-solid fa-star"></i>

                This is an Airbnb Clone Project

                <i class="fa-solid fa-star"></i>

            </span>

            <span class="airbnb-clone-text">

                <i class="fa-solid fa-star"></i>

                This is an Airbnb Clone Project

                <i class="fa-solid fa-star"></i>

            </span>

            <span class="airbnb-clone-text">

                <i class="fa-solid fa-star"></i>

                This is an Airbnb Clone Project

                <i class="fa-solid fa-star"></i>

            </span>

        </div>

    </div>

</nav>


