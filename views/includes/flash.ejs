<style>
  /* --- Premium Luxury Alert Styling Overrides --- */
  .flash-alert-premium {
    border: none !important;
    border-radius: 1rem !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 1rem 1.25rem !important;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  /* Success Notification: Soft Mint Theme */
  .alert-success-premium {
    background-color: #ecfdf5 !important;
    color: #065f46 !important;
    border-left: 4px solid #10b981 !important;
  }
  .alert-success-premium .btn-close {
    filter: invert(34%) sepia(50%) saturate(735%) hue-rotate(113deg) brightness(93%) contrast(92%);
  }

  /* Error Notification: Soft Rose Theme */
  .alert-danger-premium {
    background-color: #fff5f5 !important;
    color: #9b1c1c !important;
    border-left: 4px solid #f03e3e !important;
  }
  .alert-danger-premium .btn-close {
    filter: invert(18%) sepia(61%) saturate(3015%) hue-rotate(346deg) brightness(85%) contrast(96%);
  }

  .flash-alert-premium .btn-close {
    box-shadow: none !important;
    margin-left: auto;
    position: static !important;
    padding: 0 !important;
  }
</style>

<!-- Success Alert Component -->
<% if(success && success.length){ %>
  <div class="alert flash-alert-premium alert-success-premium alert-dismissible fade show col-lg-6 col-md-8 mx-auto mt-3" role="alert">
    <i class="fa-solid fa-circle-check fa-lg"></i>
    <div><%= success %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %> 

<!-- Error Alert Component -->
<% if(error && error.length){ %>
  <div class="alert flash-alert-premium alert-danger-premium alert-dismissible fade show col-lg-6 col-md-8 mx-auto mt-3" role="alert">
    <i class="fa-solid fa-circle-exclamation fa-lg"></i>
    <div><%= error %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>
