<% layout("/layouts/boilerplate") %>

<style>
    :root {
        --red: #ff385c;
        --dark: #222;
        --gray: #717171;
        --border: #ddd;
    }

    * {
        box-sizing: border-box;
    }

    .airbnb-show {
        width: 100%;
        max-width: 1120px;
        margin: auto;
        padding: 28px 24px 70px;
    }

    /* HEADER */

    .listing-header {
        margin-bottom: 22px;
    }

    .listing-title {
        margin: 0 0 10px;
        color: var(--dark);
        font-size: 28px;
        font-weight: 600;
        line-height: 1.25;
        word-break: break-word;
    }

    .listing-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        color: var(--gray);
        font-size: 14px;
    }

    .listing-meta strong,
    .listing-meta a {
        color: var(--dark);
    }

    .listing-meta a {
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .listing-meta a:hover {
        color: var(--red);
    }

    .listing-meta i {
        color: var(--dark);
        font-size: 12px;
    }

    /* PHOTO GRID */

    .photo-grid {
        width: 100%;
        height: 448px;
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        grid-template-rows: 220px 220px;
        gap: 6px;
        overflow: hidden;
        border-radius: 16px;
        margin-bottom: 42px;
        background: #eee;
    }

    .photo-grid a {
        display: block;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #eee;
    }

    .photo-grid img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform .3s ease;
    }

    .photo-grid a:hover img {
        transform: scale(1.03);
    }

    .photo-main {
        grid-row: 1 / 3;
        grid-column: 1;
    }

    .view-all-photos {
        position: relative;
        z-index: 5;
        float: right;
        margin-top: -58px;
        margin-right: 18px;
        padding: 9px 14px;
        border: 1px solid #222;
        border-radius: 8px;
        background: #fff;
        color: #222;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .view-all-photos:hover {
        background: #f7f7f7;
    }

    .photo-grid-empty {
        height: 448px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 16px;
        background: #f5f5f5;
        color: var(--gray);
    }

    .photo-grid-empty i {
        font-size: 40px;
    }

    /* MAIN LAYOUT */

    .show-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 370px;
        gap: 55px;
        align-items: start;
    }

    .details-column {
        min-width: 0;
    }

    .map-column {
        min-width: 0;
        position: sticky;
        top: 100px;
    }

    /* HOST */

    .host-section {
        padding-bottom: 28px;
    }

    .host-row {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .host-avatar,
    .review-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f0f0f0;
        color: #555;
    }

    .host-avatar {
        width: 52px;
        height: 52px;
        min-width: 52px;
        font-size: 20px;
    }

    .host-title {
        margin: 0 0 5px;
        color: var(--dark);
        font-size: 22px;
        font-weight: 600;
    }

    .host-subtitle {
        margin: 0;
        color: var(--gray);
        font-size: 15px;
    }

    /* SECTIONS */

    .section {
        margin-top: 32px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
    }

    .section-title {
        margin-bottom: 22px;
        color: var(--dark);
        font-size: 22px;
        font-weight: 600;
    }

    /* FEATURES */

    .features {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .feature-row {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .feature-icon {
        width: 28px;
        min-width: 28px;
        color: var(--dark);
        text-align: center;
        font-size: 21px;
    }

    .feature-text strong {
        display: block;
        margin-bottom: 3px;
        color: var(--dark);
        font-size: 15px;
    }

    .feature-text span {
        display: block;
        color: var(--gray);
        font-size: 14px;
        line-height: 1.5;
    }

    /* DESCRIPTION */

    .description {
        margin: 0;
        color: #484848;
        font-size: 15px;
        line-height: 1.75;
        white-space: pre-line;
        word-break: break-word;
    }

    /* BOOKING */

    .booking-card {
        width: 100%;
        margin-top: 32px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(0, 0, 0, .12);
    }

    .booking-price {
        display: flex;
        align-items: baseline;
        gap: 5px;
        margin-bottom: 22px;
    }

    .booking-price strong {
        color: var(--dark);
        font-size: 22px;
        font-weight: 600;
    }

    .booking-price span {
        color: var(--gray);
        font-size: 14px;
    }

    .booking-fields {
        display: grid;
        grid-template-columns: 1fr 1fr;
        overflow: hidden;
        margin-bottom: 16px;
        border: 1px solid #b0b0b0;
        border-radius: 10px;
    }

    .booking-field {
        min-width: 0;
        padding: 10px 12px;
    }

    .booking-field:first-child {
        border-right: 1px solid #b0b0b0;
    }

    .booking-field label {
        display: block;
        margin-bottom: 4px;
        color: var(--dark);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .booking-field input {
        width: 100%;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #555;
        font-size: 13px;
    }

    .reserve-btn {
        width: 100%;
        padding: 13px 16px;
        border: 0;
        border-radius: 8px;
        background: var(--red);
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        transition: .2s;
    }

    .reserve-btn:hover {
        background: #e31c5f;
        color: #fff;
    }

    .booking-note {
        margin: 14px 0 0;
        color: var(--gray);
        font-size: 12px;
        text-align: center;
    }

    /* OWNER */

    .owner-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .owner-actions form {
        margin: 0;
    }

    /* MAP */

    .map-title {
        margin: 0 0 15px;
        color: var(--dark);
        font-size: 22px;
        font-weight: 600;
    }

    #map {
        width: 100%;
        height: 520px;
        overflow: hidden;
        border-radius: 16px;
        background: #f1f1f1;
    }

    /* REVIEWS */

    .review-summary {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 28px;
        color: var(--dark);
    }

    .review-summary i {
        font-size: 14px;
    }

    .review-summary strong {
        font-size: 15px;
    }

    .review-summary span {
        color: var(--gray);
        font-size: 14px;
    }

    .review-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 36px 48px;
    }

    .review-card {
        min-width: 0;
    }

    .review-author {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .review-avatar {
        width: 42px;
        height: 42px;
        min-width: 42px;
        font-weight: 600;
    }

    .review-author strong {
        display: block;
        color: var(--dark);
        font-size: 14px;
    }

    .review-stars {
        margin-top: 2px;
    }

    .review-stars i {
        color: var(--dark);
        font-size: 11px;
    }

    .review-comment {
        margin: 0;
        color: #484848;
        font-size: 14px;
        line-height: 1.65;
        word-break: break-word;
    }

    .review-delete {
        margin-top: 12px;
    }

    .review-delete button {
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--gray);
        font-size: 12px;
        text-decoration: underline;
    }

    .review-delete button:hover {
        color: var(--red);
    }

    /* REVIEW FORM */

    .review-form {
        max-width: 650px;
    }

    .review-form .form-label {
        color: var(--dark);
        font-size: 14px;
    }

    .review-form .form-control,
    .review-form .form-select {
        padding: 11px 12px;
        border: 1px solid #b0b0b0;
        border-radius: 8px;
        box-shadow: none;
    }

    .review-form .form-control:focus,
    .review-form .form-select:focus {
        border-color: #222;
        box-shadow: 0 0 0 1px #222;
    }

    .login-review-box {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: #fafafa;
        color: #555;
    }

    .login-review-box > i {
        color: #777;
        font-size: 24px;
    }

    .login-review-box strong {
        display: block;
        margin-bottom: 3px;
        color: var(--dark);
    }

    .login-review-box p {
        color: var(--gray);
        font-size: 14px;
    }

    /* MORE LISTINGS */

    .related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .related-card {
        display: block;
        color: var(--dark);
        text-decoration: none;
    }

    .related-image {
        width: 100%;
        aspect-ratio: 1 / .9;
        overflow: hidden;
        border-radius: 14px;
        background: #f2f2f2;
    }

    .related-image img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform .25s ease;
    }

    .related-card:hover {
        color: var(--dark);
    }

    .related-card:hover img {
        transform: scale(1.03);
    }

    .related-info {
        padding-top: 8px;
    }

    .related-top {
        display: flex;
        justify-content: space-between;
        gap: 8px;
    }

    .related-top h3 {
        min-width: 0;
        margin: 0;
        overflow: hidden;
        color: var(--dark);
        font-size: 14px;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .related-top span {
        white-space: nowrap;
        font-size: 12px;
    }

    .related-top i {
        font-size: 10px;
    }

    .related-info p {
        margin: 3px 0;
        color: var(--gray);
        font-size: 13px;
    }

    .related-price {
        color: var(--dark);
        font-size: 13px;
    }

    .related-price span {
        color: var(--gray);
    }

    /* RESPONSIVE */

    @media (max-width: 1100px) {
        .show-content {
            grid-template-columns: minmax(0, 1fr) 330px;
            gap: 35px;
        }

        #map {
            height: 470px;
        }
    }

    @media (max-width: 900px) {
        .show-content {
            grid-template-columns: 1fr;
            gap: 30px;
        }

        .map-column {
            position: static;
            order: 2;
        }

        .details-column {
            order: 1;
        }

        .related-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        #map {
            height: 400px;
        }
    }

    @media (max-width: 768px) {
        .airbnb-show {
            padding: 20px 15px 45px;
        }

        .listing-title {
            font-size: 23px;
        }

        .photo-grid {
            display: block;
            height: 330px;
            border-radius: 13px;
        }

        .photo-grid .photo-main {
            display: block;
            width: 100%;
            height: 330px;
        }

        .photo-grid a:not(.photo-main) {
            display: none;
        }

        .view-all-photos {
            margin-top: -52px;
            margin-right: 12px;
        }

        .host-avatar {
            width: 48px;
            height: 48px;
            min-width: 48px;
        }

        .host-title {
            font-size: 20px;
        }

        .feature-row {
            gap: 15px;
        }

        .section-title,
        .map-title {
            font-size: 20px;
        }

        .description {
            font-size: 14px;
        }

        .booking-card {
            padding: 19px;
        }

        .booking-fields {
            grid-template-columns: 1fr;
        }

        .booking-field:first-child {
            border-right: 0;
            border-bottom: 1px solid #b0b0b0;
        }

        .review-grid,
        .related-grid {
            grid-template-columns: 1fr;
        }

        .owner-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .owner-actions .btn,
        .owner-actions form,
        .owner-actions form button {
            width: 100%;
        }

        #map {
            height: 340px;
        }
    }

    @media (max-width: 576px) {
        .airbnb-show {
            padding: 18px 12px 35px;
        }

        .listing-title {
            font-size: 21px;
        }

        .photo-grid,
        .photo-grid .photo-main {
            height: 285px;
        }

        .section {
            margin-top: 27px;
            padding-top: 27px;
        }

        .booking-card {
            padding: 17px;
        }

        #map {
            height: 290px;
        }
    }

    @media (max-width: 400px) {
        .airbnb-show {
            padding-left: 10px;
            padding-right: 10px;
        }

        .listing-title {
            font-size: 20px;
        }

        .photo-grid,
        .photo-grid .photo-main {
            height: 245px;
        }

        #map {
            height: 250px;
        }
    }
</style>


<div class="airbnb-show">

    <!-- HEADER -->

    <div class="listing-header">

        <h1 class="listing-title">
            <%= listing.title %>
        </h1>

        <div class="listing-meta">

            <% if (listing.review && listing.review.length > 0) { %>

                <strong>
                    <i class="fa-solid fa-star"></i>

                    <%= (
                        listing.review.reduce(
                            (sum, review) =>
                                sum + Number(review.rating || 0),
                            0
                        ) / listing.review.length
                    ).toFixed(2) %>
                </strong>

                <span>·</span>

                <a href="#reviews">
                    <%= listing.review.length %>
                    <%= listing.review.length === 1
                        ? "review"
                        : "reviews" %>
                </a>

                <span>·</span>

            <% } %>

            <a href="#location-section">
                <%= listing.location %>
            </a>

            <span>·</span>

            <span>
                <%= listing.country %>
            </span>

        </div>

    </div>


    <!-- PHOTOS -->

    <%
        const photos =
            listing.images &&
            listing.images.length > 0
                ? listing.images
                : (
                    listing.image &&
                    listing.image.url
                        ? [listing.image]
                        : []
                );

        const visiblePhotos = photos.slice(0, 5);
    %>

    <% if (photos.length > 0) { %>

        <div class="photo-grid">

            <% visiblePhotos.forEach((photo, index) => { %>

                <a
                    href="<%= photo.url %>"
                    target="_blank"
                    class="<%= index === 0 ? 'photo-main' : '' %>"
                >

                    <img
                        src="<%= photo.url %>"
                        alt="<%= listing.title %> photo <%= index + 1 %>"
                    >

                </a>

            <% }) %>

        </div>

        <% if (photos.length > 5) { %>

            <button
                type="button"
                class="view-all-photos"
                onclick="openPhotoGallery()"
            >
                <i class="fa-solid fa-images"></i>
                Show all <%= photos.length %> photos
            </button>

        <% } %>

    <% } else { %>

        <div class="photo-grid-empty">

            <i class="fa-regular fa-image"></i>

            <span>
                No photos available
            </span>

        </div>

    <% } %>


    <!-- MAIN TWO COLUMN AREA -->

    <div class="show-content">

        <!-- LEFT -->

        <div class="details-column">

            <!-- HOST -->

            <div class="host-section">

                <div class="host-row">

                    <div class="host-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>

                        <h2 class="host-title">
                            Hosted by
                            <%= listing.owner && listing.owner.username
                                ? listing.owner.username
                                : "Wanderlust host" %>
                        </h2>

                        <p class="host-subtitle">
                            Your comfortable stay awaits
                        </p>

                    </div>

                </div>

            </div>


            <!-- FEATURES -->

            <div class="section">

                <div class="features">

                    <div class="feature-row">

                        <div class="feature-icon">
                            <i class="fa-solid fa-house"></i>
                        </div>

                        <div class="feature-text">

                            <strong>
                                Entire place
                            </strong>

                            <span>
                                You'll have the whole place to yourself.
                            </span>

                        </div>

                    </div>


                    <div class="feature-row">

                        <div class="feature-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>

                        <div class="feature-text">

                            <strong>
                                Great location
                            </strong>

                            <span>
                                A convenient location for your stay.
                            </span>

                        </div>

                    </div>


                    <div class="feature-row">

                        <div class="feature-icon">
                            <i class="fa-solid fa-heart"></i>
                        </div>

                        <div class="feature-text">

                            <strong>
                                Guest favorite
                            </strong>

                            <span>
                                A popular choice among Wanderlust guests.
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- DESCRIPTION -->

            <div class="section">

                <h2 class="section-title">
                    About this place
                </h2>

                <p class="description">
                    <%= listing.description %>
                </p>

            </div>


            <!-- BOOKING -->

            <div class="booking-card">

                <div class="booking-price">

                    <strong>
                        Rs.
                        <%= Number(
                            listing.price || 0
                        ).toLocaleString("en-PK") %>
                    </strong>

                    <span>
                        night
                    </span>

                </div>

                <form
                    action="/listings/<%= listing._id %>/bookings"
                    method="GET"
                >

                    <div class="booking-fields">

                        <div class="booking-field">

                            <label for="checkin">
                                Check in
                            </label>

                            <input
                                type="date"
                                id="checkin"
                                name="checkIn"
                                required
                            >

                        </div>


                        <div class="booking-field">

                            <label for="checkout">
                                Check out
                            </label>

                            <input
                                type="date"
                                id="checkout"
                                name="checkOut"
                                required
                            >

                        </div>

                    </div>

                    <button
                        type="submit"
                        class="reserve-btn"
                    >
                        Reserve
                    </button>

                    <p class="booking-note">
                        You won't be charged yet
                    </p>

                </form>

            </div>


            <!-- OWNER -->

            <% if (
                currUser &&
                listing.owner &&
                listing.owner._id &&
                currUser._id &&
                listing.owner._id.equals(currUser._id)
            ) { %>

                <div class="section">

                    <h2 class="section-title">
                        Manage your listing
                    </h2>

                    <div class="owner-actions">

                        <a
                            href="/listings/<%= listing._id %>/edit"
                            class="btn btn-dark px-4"
                        >
                            <i class="fa-solid fa-pen me-2"></i>
                            Edit listing
                        </a>


                        <form
                            method="POST"
                            action="/listings/<%= listing._id %>?_method=DELETE"
                        >

                            <button
                                type="submit"
                                class="btn btn-outline-danger px-4"
                            >
                                <i class="fa-solid fa-trash me-2"></i>
                                Delete listing
                            </button>

                        </form>

                    </div>

                </div>

            <% } %>


            <!-- REVIEWS -->

            <div class="section" id="reviews">

                <h2 class="section-title">
                    Guest reviews
                </h2>


                <% if (listing.review && listing.review.length > 0) { %>

                    <%
                        const averageRating =
                            listing.review.reduce(
                                (sum, review) =>
                                    sum + Number(review.rating || 0),
                                0
                            ) / listing.review.length;
                    %>

                    <div class="review-summary">

                        <i class="fa-solid fa-star"></i>

                        <strong>
                            <%= averageRating.toFixed(2) %>
                        </strong>

                        <span>
                            ·
                            <%= listing.review.length %>
                            <%= listing.review.length === 1
                                ? "review"
                                : "reviews" %>
                        </span>

                    </div>


                    <div class="review-grid">

                        <% listing.review.forEach(review => { %>

                            <div class="review-card">

                                <div class="review-author">

                                    <div class="review-avatar">

                                        <%= review.author &&
                                            review.author.username
                                            ? review.author.username
                                                .charAt(0)
                                                .toUpperCase()
                                            : "A" %>

                                    </div>


                                    <div>

                                        <strong>
                                            <%= review.author &&
                                                review.author.username
                                                ? review.author.username
                                                : "Anonymous" %>
                                        </strong>

                                        <div class="review-stars">

                                            <% for (
                                                let i = 1;
                                                i <= 5;
                                                i++
                                            ) { %>

                                                <% if (
                                                    i <= Number(
                                                        review.rating || 0
                                                    )
                                                ) { %>

                                                    <i class="fa-solid fa-star"></i>

                                                <% } else { %>

                                                    <i class="fa-regular fa-star"></i>

                                                <% } %>

                                            <% } %>

                                        </div>

                                    </div>

                                </div>


                                <p class="review-comment">
                                    <%= review.comment %>
                                </p>


                                <% if (
                                    currUser &&
                                    review.author &&
                                    review.author._id &&
                                    currUser._id &&
                                    review.author._id.equals(currUser._id)
                                ) { %>

                                    <form
                                        method="POST"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        class="review-delete"
                                    >

                                        <button type="submit">
                                            Delete review
                                        </button>

                                    </form>

                                <% } %>

                            </div>

                        <% }) %>

                    </div>

                <% } else { %>

                    <p class="text-muted mb-4">
                        No reviews yet.
                        Be the first guest to share your experience.
                    </p>

                <% } %>


                <!-- REVIEW FORM -->

                <div class="section">

                    <h2 class="section-title">
                        Leave a review
                    </h2>


                    <% if (currUser) { %>

                        <form
                            action="/listings/<%= listing._id %>/reviews"
                            method="POST"
                            class="review-form needs-validation"
                            novalidate
                        >

                            <div class="mb-3">

                                <label
                                    for="rating"
                                    class="form-label fw-semibold"
                                >
                                    Rating
                                </label>

                                <select
                                    name="review[rating]"
                                    id="rating"
                                    class="form-select"
                                    required
                                >

                                    <option value="">
                                        Choose a rating
                                    </option>

                                    <option value="5">
                                        ★★★★★ — Excellent
                                    </option>

                                    <option value="4">
                                        ★★★★☆ — Very good
                                    </option>

                                    <option value="3">
                                        ★★★☆☆ — Good
                                    </option>

                                    <option value="2">
                                        ★★☆☆☆ — Fair
                                    </option>

                                    <option value="1">
                                        ★☆☆☆☆ — Poor
                                    </option>

                                </select>

                                <div class="invalid-feedback">
                                    Please select a rating.
                                </div>

                            </div>


                            <div class="mb-3">

                                <label
                                    for="comment"
                                    class="form-label fw-semibold"
                                >
                                    Your review
                                </label>

                                <textarea
                                    name="review[comment]"
                                    id="comment"
                                    class="form-control"
                                    rows="5"
                                    placeholder="Share your experience..."
                                    required
                                ></textarea>

                                <div class="invalid-feedback">
                                    Please write a review.
                                </div>

                            </div>


                            <button
                                type="submit"
                                class="btn btn-dark px-4"
                            >
                                <i class="fa-regular fa-paper-plane me-2"></i>
                                Submit Review
                            </button>

                        </form>

                    <% } else { %>

                        <div class="login-review-box">

                            <i class="fa-regular fa-comment-dots"></i>

                            <div>

                                <strong>
                                    Want to leave a review?
                                </strong>

                                <p class="mb-0">
                                    Please login to share your experience.
                                </p>

                            </div>

                        </div>

                    <% } %>

                </div>

            </div>


            <!-- MORE LISTINGS
                 This is BELOW reviews + review form -->

            <% if (relatedListings && relatedListings.length > 0) { %>

                <div class="section">

                    <h2 class="section-title">
                        More stays in <%= listing.country %>
                    </h2>


                    <div class="related-grid">

                        <% relatedListings.forEach(related => { %>

                            <a
                                href="/listings/<%= related._id %>"
                                class="related-card"
                            >

                                <div class="related-image">

                                    <img
                                        src="<%= related.image && related.image.url
                                            ? related.image.url
                                            : '/images/placeholder.jpg' %>"
                                        alt="<%= related.title %>"
                                        loading="lazy"
                                    >

                                </div>


                                <div class="related-info">

                                    <div class="related-top">

                                        <h3>
                                            <%= related.title %>
                                        </h3>

                                        <span>
                                            <i class="fa-solid fa-star"></i>
                                            4.9
                                        </span>

                                    </div>


                                    <p>
                                        <%= related.location %>,
                                        <%= related.country %>
                                    </p>


                                    <div class="related-price">

                                        <strong>
                                            Rs.
                                            <%= Number(
                                                related.price || 0
                                            ).toLocaleString("en-PK") %>
                                        </strong>

                                        <span>
                                            / night
                                        </span>

                                    </div>

                                </div>

                            </a>

                        <% }) %>

                    </div>

                </div>

            <% } %>

        </div>


        <!-- RIGHT MAP -->

        <aside
            class="map-column"
            id="location-section"
        >

            <h2 class="map-title">
                Where you'll be
            </h2>

            <div id="map"></div>

        </aside>

    </div>

</div>


<!-- MAPBOX -->

<link
    href="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.css"
    rel="stylesheet"
/>

<script src="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.js"></script>


<script type="application/json" id="listing-data">
    <%- JSON.stringify(listing) %>
</script>


<script>

    const listing =
        JSON.parse(
            document.getElementById("listing-data").textContent
        );


    const mapToken =
        "<%= process.env.MAP_TOKEN %>";


    mapboxgl.accessToken = mapToken;


    const geometry =
        listing.geometry;


    const coordinates =
        geometry &&
        geometry.type === "Point" &&
        Array.isArray(geometry.coordinates) &&
        geometry.coordinates.length === 2
            ? geometry.coordinates
            : null;


    function showMapError(message) {

        document.getElementById("map").innerHTML = `

            <div
                class="h-100 d-flex flex-column
                align-items-center justify-content-center text-muted"
            >

                <i class="fa-solid fa-location-dot fs-1 mb-3"></i>

                <h5>
                    ${message}
                </h5>

                <p>
                    Coordinates for this listing are not available.
                </p>

            </div>

        `;
    }


    if (coordinates) {

        const longitude =
            Number(coordinates[0]);

        const latitude =
            Number(coordinates[1]);


        if (
            Number.isFinite(longitude) &&
            Number.isFinite(latitude)
        ) {

            const map =
                new mapboxgl.Map({

                    container: "map",

                    style:
                        "mapbox://styles/mapbox/streets-v12",

                    center:
                        [longitude, latitude],

                    zoom: 14

                });


            map.addControl(
                new mapboxgl.NavigationControl(),
                "top-right"
            );


            const marker =
                new mapboxgl.Marker({
                    color: "#ff385c"
                })
                .setLngLat([
                    longitude,
                    latitude
                ])
                .setPopup(
                    new mapboxgl.Popup({
                        offset: 25
                    }).setHTML(`

                        <strong>
                            ${listing.title}
                        </strong>

                        <br>

                        ${listing.location},
                        ${listing.country}

                    `)
                )
                .addTo(map);


            marker.togglePopup();


            map.on("load", function () {

                map.resize();

            });


            window.addEventListener(
                "resize",
                function () {
                    map.resize();
                }
            );


        } else {

            showMapError(
                "Location coordinates are invalid."
            );

        }

    } else {

        showMapError(
            "Location not available."
        );

    }

</script>