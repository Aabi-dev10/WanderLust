<% layout("/layouts/boilerplate") %>

<style>
  :root {
    --red: #ff385c;
    --red-dark: #e31c5f;
    --black: #222;
    --gray: #717171;
    --border: #ddd;
  }

  .create-listing-page {
    min-height: calc(100vh - 90px);
    padding: 18px 20px 70px;
  }

  .create-listing-wrapper {
    max-width: 900px;
    margin: auto;
  }

  .listing-page-header {
    margin-bottom: 26px;
  }

  .listing-page-header h1 {
    margin: 0 0 7px;
    color: var(--black);
    font-size: 30px;
    font-weight: 600;
  }

  .listing-page-header p {
    margin: 0;
    color: var(--gray);
    font-size: 15px;
  }

  .listing-form-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: 0 4px 18px rgba(0,0,0,.06);
  }

  .listing-form-body {
    padding: 34px 38px 38px;
  }

  .form-section {
    margin-bottom: 30px;
  }

  .section-heading {
    display: flex;
    gap: 13px;
    margin-bottom: 19px;
  }

  .section-icon {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: #fff0f2;
    color: var(--red);
  }

  .section-heading h3 {
    margin: 0 0 3px;
    color: var(--black);
    font-size: 17px;
  }

  .section-heading p {
    margin: 0;
    color: var(--gray);
    font-size: 13px;
  }

  .section-divider {
    height: 1px;
    background: #eee;
    margin: 28px 0;
  }

  .listing-field {
    margin-bottom: 19px;
  }

  .listing-label {
    display: block;
    margin-bottom: 7px;
    color: var(--black);
    font-size: 14px;
    font-weight: 600;
  }

  .listing-input,
  .listing-textarea,
  .listing-select {
    width: 100%;
    border: 1px solid #b0b0b0 !important;
    border-radius: 9px !important;
    background: #fff !important;
    color: var(--black);
  }

  .listing-input {
    min-height: 48px;
    padding: 11px 13px !important;
  }

  .listing-textarea {
    min-height: 125px;
    padding: 12px 13px !important;
    resize: vertical;
  }

  .listing-select {
    min-height: 48px;
    padding: 11px 13px !important;
  }

  .listing-input:focus,
  .listing-textarea:focus,
  .listing-select:focus {
    border-color: var(--black) !important;
    box-shadow: 0 0 0 1px var(--black) !important;
  }

  /* MULTIPLE IMAGE UPLOAD */

  .image-upload-box {
    border: 1.5px dashed #b0b0b0;
    border-radius: 13px;
    padding: 22px;
    background: #fafafa;
  }

  .image-upload-content {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .image-upload-icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #fff;
    border: 1px solid #eee;
    color: var(--red);
    font-size: 20px;
  }

  .image-upload-text {
    flex: 1;
  }

  .image-upload-text strong {
    display: block;
    margin-bottom: 3px;
    color: var(--black);
    font-size: 14px;
  }

  .image-upload-text span {
    color: var(--gray);
    font-size: 12px;
  }

  .image-upload-input {
    width: 100%;
    margin-top: 15px;
    padding: 8px 10px;
    border: 1px solid #b0b0b0;
    border-radius: 9px;
    background: #fff;
  }

  .category-hint,
  .field-help {
    margin-top: 7px;
    color: var(--gray);
    font-size: 12px;
  }

  .category-hint {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .category-hint i {
    color: var(--red);
  }

  .price-wrapper {
    position: relative;
  }

  .price-prefix {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray);
    pointer-events: none;
  }

  .price-input {
    padding-left: 43px !important;
  }

  .listing-submit-area {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
    padding-top: 25px;
    border-top: 1px solid #eee;
  }

  .submit-note {
    color: var(--gray);
    font-size: 12px;
  }

  .submit-note i {
    color: var(--red);
    margin-right: 6px;
  }

  .add-listing-btn {
    min-height: 48px;
    padding: 0 28px;
    border: 0 !important;
    border-radius: 9px !important;
    background: var(--red) !important;
    color: #fff !important;
    font-weight: 600;
  }

  .add-listing-btn:hover {
    background: var(--red-dark) !important;
  }

  @media (max-width: 768px) {
    .create-listing-page {
      padding: 12px 14px 50px;
    }

    .listing-form-body {
      padding: 28px 22px;
    }

    .listing-submit-area {
      flex-direction: column;
      align-items: stretch;
    }

    .add-listing-btn {
      width: 100%;
    }

    .submit-note {
      text-align: center;
    }
  }

  @media (max-width: 576px) {
    .create-listing-page {
      padding: 8px 10px 40px;
    }

    .listing-form-body {
      padding: 24px 18px;
    }

    .listing-page-header h1 {
      font-size: 24px;
    }

    .image-upload-content {
      align-items: flex-start;
    }
  }
</style>


<div class="create-listing-page">

  <div class="create-listing-wrapper">

    <div class="listing-page-header">

      <h1>Create a new listing</h1>

      <p>
        Share your place with travelers and start hosting on Wanderlust.
      </p>

    </div>


    <div class="listing-form-card">

      <div class="listing-form-body">

        <form
          method="POST"
          action="/listings"
          novalidate
          class="needs-validation"
          enctype="multipart/form-data"
        >

          <!-- BASIC INFORMATION -->

          <div class="form-section">

            <div class="section-heading">

              <div class="section-icon">
                <i class="fa-solid fa-house"></i>
              </div>

              <div>
                <h3>Tell guests about your place</h3>

                <p>
                  Start with a clear title and an inviting description.
                </p>
              </div>

            </div>


            <div class="listing-field">

              <label
                for="title"
                class="listing-label"
              >
                Title
              </label>

              <input
                id="title"
                name="listing[title]"
                placeholder="Give your place a memorable title"
                type="text"
                class="form-control listing-input"
                required
              >

              <div class="valid-feedback">
                Title looks good!
              </div>

              <div class="invalid-feedback">
                Please enter a valid title.
              </div>

            </div>


            <div class="listing-field">

              <label
                for="description"
                class="listing-label"
              >
                Description
              </label>

              <textarea
                id="description"
                name="listing[description]"
                rows="5"
                class="form-control listing-textarea"
                placeholder="Tell guests what makes your property special..."
                required
              ></textarea>

              <div class="field-help">
                A detailed description helps guests understand what to expect.
              </div>

              <div class="invalid-feedback">
                Please enter a valid description.
              </div>

            </div>

          </div>


          <div class="section-divider"></div>


          <!-- MULTIPLE PHOTOS -->

          <div class="form-section">

            <div class="section-heading">

              <div class="section-icon">
                <i class="fa-solid fa-images"></i>
              </div>

              <div>

                <h3>Add photos</h3>

                <p>
                  Upload multiple photos of your property.
                </p>

              </div>

            </div>


            <div class="image-upload-box">

              <div class="image-upload-content">

                <div class="image-upload-icon">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>

                <div class="image-upload-text">

                  <strong>
                    Upload your listing photos
                  </strong>

                  <span>
                    JPG, JPEG or PNG · Up to 10 photos
                  </span>

                </div>

              </div>


              <input
                id="images"
                name="listing[images]"
                type="file"
                class="image-upload-input"
                accept="image/png,image/jpeg,image/jpg"
                multiple
                required
              >

              <div class="field-help">
                Select several photos at once. The first photo will be your main listing photo.
              </div>

              <div class="invalid-feedback">
                Please select at least one image.
              </div>

            </div>

          </div>


          <div class="section-divider"></div>


          <!-- CATEGORY -->

          <div class="form-section">

            <div class="section-heading">

              <div class="section-icon">
                <i class="fa-solid fa-layer-group"></i>
              </div>

              <div>

                <h3>Choose a category</h3>

                <p>
                  Help guests discover your property.
                </p>

              </div>

            </div>


            <div class="listing-field">

              <label
                for="category"
                class="listing-label"
              >
                Category
              </label>

              <select
                id="category"
                name="listing[category]"
                class="form-select listing-select"
                required
              >

                <option
                  value=""
                  disabled
                  selected
                >
                  Choose a category for your property...
                </option>

                <option value="Trending">
                  🔥 Trending
                </option>

                <option value="Rooms">
                  🛏️ Rooms
                </option>

                <option value="Iconic Cities">
                  🏙️ Iconic Cities
                </option>

                <option value="Mountains">
                  ⛰️ Mountains
                </option>

                <option value="Castles">
                  🏰 Castles
                </option>

                <option value="Amazing Pools">
                  🏊 Amazing Pools
                </option>

                <option value="Camping">
                  ⛺ Camping
                </option>

                <option value="Farms">
                  🌾 Farms
                </option>

                <option value="Arctic">
                  ❄️ Arctic
                </option>

                <option value="Domes">
                  ⚗️ Domes
                </option>

                <option value="Boats">
                  ⛵ Boats
                </option>

              </select>

              <div class="category-hint">
                <i class="fa-solid fa-circle-info"></i>
                Select the category that best matches your property.
              </div>

              <div class="invalid-feedback">
                Please choose a valid category.
              </div>

            </div>

          </div>


          <div class="section-divider"></div>


          <!-- PRICE + LOCATION -->

          <div class="form-section">

            <div class="section-heading">

              <div class="section-icon">
                <i class="fa-solid fa-location-dot"></i>
              </div>

              <div>

                <h3>Pricing and location</h3>

                <p>
                  Let guests know where you are and what the nightly rate is.
                </p>

              </div>

            </div>


            <div class="row g-3">

              <div class="col-md-4">

                <div class="listing-field">

                  <label
                    for="price"
                    class="listing-label"
                  >
                    Price per night
                  </label>

                  <div class="price-wrapper">

                    <span class="price-prefix">
                      Rs.
                    </span>

                    <input
                      id="price"
                      name="listing[price]"
                      placeholder="2500"
                      type="number"
                      class="form-control listing-input price-input"
                      min="0"
                      required
                    >

                  </div>

                  <div class="invalid-feedback">
                    Please enter a correct numerical price.
                  </div>

                </div>

              </div>


              <div class="col-md-8">

                <div class="listing-field">

                  <label
                    for="country"
                    class="listing-label"
                  >
                    Country
                  </label>

                  <input
                    id="country"
                    name="listing[country]"
                    placeholder="e.g., Pakistan"
                    type="text"
                    class="form-control listing-input"
                    required
                  >

                  <div class="invalid-feedback">
                    Please enter a valid country name.
                  </div>

                </div>

              </div>

            </div>


            <div class="listing-field">

              <label
                for="location"
                class="listing-label"
              >
                Location / City
              </label>

              <input
                id="location"
                name="listing[location]"
                placeholder="e.g., Islamabad"
                type="text"
                class="form-control listing-input"
                required
              >

              <div class="field-help">
                Enter the city or location where your property is located.
              </div>

              <div class="invalid-feedback">
                Please enter a valid location name.
              </div>

            </div>

          </div>


          <!-- SUBMIT -->

          <div class="listing-submit-area">

            <div class="submit-note">

              <i class="fa-solid fa-shield-heart"></i>

              Your listing details can be updated later.

            </div>


            <button
              type="submit"
              class="btn add-listing-btn"
            >

              <i class="fa-solid fa-circle-plus me-2"></i>

              Add Listing

            </button>

          </div>

        </form>

      </div>

    </div>

  </div>

</div>


<script>

(() => {

    "use strict";

    const forms =
        document.querySelectorAll(
            ".needs-validation"
        );


    Array
        .from(forms)
        .forEach(form => {

            form.addEventListener(
                "submit",
                event => {

                    if (!form.checkValidity()) {

                        event.preventDefault();
                        event.stopPropagation();

                    }

                    form.classList.add(
                        "was-validated"
                    );

                },
                false
            );

        });

})();

</script>